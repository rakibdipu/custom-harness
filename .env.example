# ============================================================
# CUSTOM HARNESS v2.0 — Environment Variables
# ============================================================

# ── ⚡ LAPTOP ECO / LOW-RESOURCE MODE (MoneyPrinterTurbo Feature) ─
# Keeps laptop fans quiet, limits CPU threads, and prevents system lag!
LOW_RESOURCE_MODE=false        # Set to true for lightweight laptop mode
VIDEO_QUALITY=1080p            # 1080p (standard) or 720p (2.5x faster, 60% less CPU)
FFMPEG_THREADS=0               # 0 = auto, 2 = low-resource limit (recommended on laptops)

# ── ☁️ CLOUD LLM ENGINES (MoneyPrinterTurbo Feature) ───────────
# If set, script generation uses Cloud APIs with 0% CPU and 0% RAM usage!
GEMINI_API_KEY=                # Free & ultra fast (<1s) from Google AI Studio
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=                  # Free LPU fast inference (llama-3.3-70b-versatile)
OPENAI_API_KEY=                # OpenAI key (gpt-4o-mini)
DEEPSEEK_API_KEY=              # DeepSeek API key
OPENROUTER_API_KEY=            # OpenRouter API key

# ── 🖥️ LOCAL OLLAMA (Local LLM Fallback) ─────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── 🎬 STOCK VIDEO / B-ROLL APIS (MoneyPrinterTurbo Feature) ───
# Downloads genuine vertical HD stock clips directly (cuts rendering CPU by 50%)
PEXELS_API_KEY=                # Free key from https://www.pexels.com/api/
PIXABAY_API_KEY=               # Free key from https://pixabay.com/api/docs/

# ── 🚀 PUBLISHING TOGGLES ────────────────────────────────────
PUBLISH_FACEBOOK=false
PUBLISH_YOUTUBE=false

# ── ACCOUNT 1: Psychology & Mindset ─────────────────────────
FB_PAGE_ID_PSYCHOLOGY=your_page_id_here
FB_TOKEN_PSYCHOLOGY=your_page_access_token_here

# ── ACCOUNT 2: Cartoon / Fun ─────────────────────────────────
FB_PAGE_ID_CARTOON=your_page_id_here
FB_TOKEN_CARTOON=your_page_access_token_here

# ── ACCOUNT 3: Story-telling ─────────────────────────────────
FB_PAGE_ID_STORY=your_page_id_here
FB_TOKEN_STORY=your_page_access_token_here

# ── ACCOUNT 4: Comic / Viral ─────────────────────────────────
FB_PAGE_ID_COMIC=your_page_id_here
FB_TOKEN_COMIC=your_page_access_token_here

# ── YOUTUBE (one client_secret.json per channel) ─────────────
# Place client_secret.json, client_secret_cartoon.json, etc. in project root
# First run will open browser to authorize each channel

# ── SCHEDULE ─────────────────────────────────────────────────
# Edit per-account schedules in: accounts/*.json
