# ============================================================
# CUSTOM HARNESS v2.0 — Environment Variables
# ============================================================

# ── GLOBAL ──────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
PUBLISH_FACEBOOK=false
PUBLISH_YOUTUBE=false

# ── ACCOUNT 1: Psychology & Mindset ─────────────────────────
FB_PAGE_ID_PSYCHOLOGY=your_page_id_here
FB_TOKEN_PSYCHOLOGY=your_page_access_token_here

# ── ACCOUNT 2: Cartoon / Fun ─────────────────────────────────
FB_PAGE_ID_CARTOON=your_page_id_here
FB_TOKEN_CARTOON=your_page_access_token_here

# ── ACCOUNT 3: Story-telling ─────────────────────────────────
FB_PAGE_ID_STORY=your_page_id_here
FB_TOKEN_STORY=your_page_access_token_here

# ── ACCOUNT 4: Comic / Viral ─────────────────────────────────
FB_PAGE_ID_COMIC=your_page_id_here
FB_TOKEN_COMIC=your_page_access_token_here

# ── YOUTUBE (one client_secret.json per channel) ─────────────
# Place client_secret.json, client_secret_cartoon.json, etc. in project root
# First run will open browser to authorize each channel

# ── SCHEDULE ─────────────────────────────────────────────────
# Edit per-account schedules in: accounts/*.json
